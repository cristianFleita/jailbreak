<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="GameHudRoot" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
        <ui:VisualElement name="HudTop" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: flex-start;">
            <ui:VisualElement name="PhasePanel" picking-mode="Ignore" style="min-width: 220px; max-width: 420px; background-color: rgba(0, 0, 0, 0.62); padding-top: 6px; padding-right: 9px; padding-bottom: 6px; padding-left: 9px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label name="PhaseLabel" text="PHASE: WAITING" style="-unity-font-style: bold; font-size: 12px; color: rgb(255, 255, 255); white-space: normal;"/>
                <ui:Label name="TimeLabel" text="--:--" style="-unity-font-style: bold; font-size: 11px; color: rgb(255, 203, 92); margin-top: 3px; white-space: normal;"/>
                <ui:Label name="RoleLabel" text="ROLE: --" style="font-size: 10px; color: rgb(196, 216, 235); margin-top: 2px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="HudTopCenter" picking-mode="Ignore" style="flex-direction: column; align-items: center; flex-grow: 1;">
                <ui:VisualElement name="MatchInfoPanel" picking-mode="Ignore" style="flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0.72); padding-top: 6px; padding-right: 12px; padding-bottom: 6px; padding-left: 12px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left-width: 3px; border-left-color: rgb(255, 203, 92);">
                    <ui:VisualElement name="MatchPrisonersBlock" picking-mode="Ignore" style="flex-direction: column; align-items: center; margin-right: 16px;">
                        <ui:Label name="MatchPrisonersCaption" text="PRISONERS LEFT" style="font-size: 9px; color: rgb(196, 216, 235); -unity-font-style: bold; letter-spacing: 1px;"/>
                        <ui:Label name="MatchPrisonersLabel" text="--/--" style="-unity-font-style: bold; font-size: 16px; color: rgb(255, 255, 255); -unity-text-align: middle-center;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MatchTimeBlock" picking-mode="Ignore" style="flex-direction: column; align-items: center;">
                        <ui:Label name="MatchTimeCaption" text="MATCH ENDS IN" style="font-size: 9px; color: rgb(196, 216, 235); -unity-font-style: bold; letter-spacing: 1px;"/>
                        <ui:Label name="MatchTimeLabel" text="--:--" style="-unity-font-style: bold; font-size: 16px; color: rgb(255, 255, 255); -unity-text-align: middle-center;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="GuardErrorPanel" picking-mode="Ignore" style="display: none; flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0.62); padding-top: 6px; padding-right: 10px; padding-bottom: 6px; padding-left: 10px; margin-top: 4px; border-left-width: 3px; border-left-color: rgb(229, 92, 92); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Label name="GuardErrorCaption" text="MISTAKES" style="font-size: 9px; color: rgb(255, 196, 196); margin-right: 6px; -unity-font-style: bold;"/>
                    <ui:Label name="GuardErrorLabel" text="0/3" style="-unity-font-style: bold; font-size: 14px; color: rgb(255, 255, 255); -unity-text-align: middle-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="HudTopRight" picking-mode="Ignore" style="flex-direction: column; align-items: flex-end;">
                <ui:Button name="PauseMenuBtn" text="MENU [ESC]" style="padding-top: 5px; padding-right: 10px; padding-bottom: 5px; padding-left: 10px; -unity-font-style: bold; font-size: 11px; color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.62); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(255, 255, 255, 0.18); border-right-color: rgba(255, 255, 255, 0.18); border-bottom-color: rgba(255, 255, 255, 0.18); border-left-color: rgba(255, 255, 255, 0.18); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
                <ui:VisualElement name="EmoteHintPanel" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-top: 6px; background-color: rgba(0, 0, 0, 0.62); padding-top: 4px; padding-right: 8px; padding-bottom: 4px; padding-left: 8px; border-left-width: 3px; border-left-color: rgb(255, 203, 92); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Label name="EmoteHintKey" text="HOLD B" style="-unity-font-style: bold; font-size: 10px; color: rgb(255, 203, 92); margin-right: 6px; letter-spacing: 1px;"/>
                    <ui:Label name="EmoteHintLabel" text="Open emote panel" style="font-size: 10px; color: rgb(196, 216, 235);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="HudMiddle" picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: flex-start; padding-top: 54px;">
            <ui:VisualElement name="HudToast" picking-mode="Ignore" style="display: none; max-width: 520px; background-color: rgba(0, 0, 0, 0.72); padding-top: 8px; padding-right: 14px; padding-bottom: 8px; padding-left: 14px; border-left-width: 3px; border-left-color: rgb(255, 203, 92); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label name="HudToastLabel" text="" style="-unity-font-style: bold; font-size: 13px; color: rgb(255, 255, 255); white-space: normal; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="HudBottom" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: flex-end;">
            <ui:VisualElement name="InventoryPanel" picking-mode="Ignore" style="width: 228px; background-color: rgba(0, 0, 0, 0.62); padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label name="InventoryTitle" text="INVENTORY" style="-unity-font-style: bold; font-size: 11px; color: rgb(255, 255, 255); margin-bottom: 6px;"/>
                <ui:VisualElement name="HeldItem" picking-mode="Ignore" style="height: 44px; flex-direction: row; align-items: center; background-color: rgba(255, 255, 255, 0.08); padding-top: 4px; padding-right: 5px; padding-bottom: 4px; padding-left: 5px; margin-bottom: 6px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;">
                    <ui:VisualElement name="HeldItemIcon" picking-mode="Ignore" style="width: 32px; height: 32px; background-color: rgba(0, 0, 0, 0.28); -unity-background-scale-mode: scale-to-fit; margin-right: 6px;"/>
                    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;">
                        <ui:Label name="HeldItemCaption" text="HELD" style="font-size: 9px; color: rgb(161, 178, 196);"/>
                        <ui:Label name="HeldItemLabel" text="Empty hand" style="-unity-font-style: bold; font-size: 11px; color: rgb(255, 255, 255); white-space: normal;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="InventorySlots" picking-mode="Ignore" style="flex-direction: row;">
                    <ui:VisualElement name="InventorySlot0" picking-mode="Ignore" style="width: 70px; height: 50px; background-color: rgba(255, 255, 255, 0.08); padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; margin-right: 6px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;">
                        <ui:VisualElement name="InventorySlot0Icon" picking-mode="Ignore" style="align-self: center; width: 28px; height: 28px; background-color: rgba(0, 0, 0, 0.28); -unity-background-scale-mode: scale-to-fit;"/>
                        <ui:Label name="InventorySlot0Label" text="Empty" style="font-size: 9px; color: rgb(196, 216, 235); -unity-text-align: middle-center; margin-top: 2px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="InventorySlot1" picking-mode="Ignore" style="width: 70px; height: 50px; background-color: rgba(255, 255, 255, 0.08); padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;">
                        <ui:VisualElement name="InventorySlot1Icon" picking-mode="Ignore" style="align-self: center; width: 28px; height: 28px; background-color: rgba(0, 0, 0, 0.28); -unity-background-scale-mode: scale-to-fit;"/>
                        <ui:Label name="InventorySlot1Label" text="Empty" style="font-size: 9px; color: rgb(196, 216, 235); -unity-text-align: middle-center; margin-top: 2px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="Route1Panel" picking-mode="Ignore" style="width: 360px; background-color: rgba(0, 0, 0, 0.62); padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:VisualElement name="Route1Header" picking-mode="Ignore" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                    <ui:Label name="Route1Title" text="OBJECTIVE" style="-unity-font-style: bold; font-size: 12px; color: rgb(255, 255, 255); flex-grow: 1;"/>
                    <ui:Label name="Route1ToggleHint" text="[TAB]" style="font-size: 9px; color: rgb(196, 216, 235); margin-left: 6px; -unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:VisualElement name="RouteChecklist" picking-mode="Ignore" style="flex-direction: column;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="PausePanel" style="display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.78);">
            <ui:VisualElement name="PauseCard" style="min-width: 320px; max-width: 420px; background-color: rgba(20, 24, 30, 0.96); padding-top: 18px; padding-right: 22px; padding-bottom: 18px; padding-left: 22px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(255, 255, 255, 0.16); border-right-color: rgba(255, 255, 255, 0.16); border-bottom-color: rgba(255, 255, 255, 0.16); border-left-color: rgba(255, 255, 255, 0.16); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;">
                <ui:Label name="PauseTitle" text="MENU" style="-unity-font-style: bold; font-size: 22px; color: rgb(255, 255, 255); -unity-text-align: middle-center; letter-spacing: 2px; margin-bottom: 4px;"/>
                <ui:Label name="PauseHint" text="Match continues for everyone else." style="font-size: 11px; color: rgb(196, 216, 235); -unity-text-align: middle-center; margin-bottom: 16px; white-space: normal;"/>
                <ui:Button name="PauseResumeBtn" text="RESUME" style="margin-top: 4px; padding-top: 9px; padding-right: 12px; padding-bottom: 9px; padding-left: 12px; -unity-font-style: bold; font-size: 13px; color: rgb(20, 24, 30); background-color: rgb(255, 203, 92); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
                <ui:Button name="PauseLeaveBtn" text="LEAVE MATCH" style="margin-top: 8px; padding-top: 9px; padding-right: 12px; padding-bottom: 9px; padding-left: 12px; -unity-font-style: bold; font-size: 13px; color: rgb(255, 255, 255); background-color: rgba(229, 92, 92, 0.85); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
                <ui:Label name="PauseLeaveWarning" text="Leaving ends the match for your team." style="font-size: 10px; color: rgb(255, 196, 196); -unity-text-align: middle-center; margin-top: 8px; white-space: normal;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

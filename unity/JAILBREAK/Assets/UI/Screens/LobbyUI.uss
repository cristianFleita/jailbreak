/* --- ROOT & BACKGROUND --- */
.screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 22, 25);
    flex-direction: column;
}

/* --- TOP BAR LAYOUT --- */
.top-bar {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    padding-top: 20px;
    margin-bottom: 20px;
}

.top-bar-spacer { flex: 1; }
.header-container { flex: 1; align-items: center; justify-content: flex-start; }
.profile-container { flex: 1; align-items: flex-end; padding-right: 40px; }

/* --- HEADER LOGO --- */
.logo-icon {
    width: 400px;
    height: 150px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

/* --- PLAYER PROFILE PANEL --- */
.profile-panel {
    width: 350px;
    height: 130px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: flex-start;
    -unity-background-scale-mode: scale-to-fit;
}

/* Only the text remains, pushed perfectly into the dark slot */
.profile-text {
    font-size: 18px;
    color: rgb(225, 150, 50);
    margin-top: 55px; 
    -unity-font-style: bold;
}

/* --- MAIN CONTENT (RESPONSIVE SCROLLING & SIDE-BY-SIDE) --- */
.content-area {
    flex-grow: 1;
    width: 100%;
}

/* CRITICAL: Target the ScrollView's internal content container for wrapping */
.content-area .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    min-height: 100%; /* Ensures vertical centering when no scrolling is needed */
    padding-bottom: 40px; /* Padding for when users scroll down */
}

/* --- LARGE METAL PANELS --- */
.main-panel {
    width: 500px;
    height: 350px; 
    margin: 20px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: flex-start; 
    -unity-background-scale-mode: scale-to-fit;
}

/* --- INPUT FIELDS --- */
.input-container {
    width: 380px;
    height: 50px;
    margin-top: 185px; /* Pushes into the dark slot below the baked label */
    align-items: center;
    justify-content: center;
}

.input-field {
    width: 100%;
    height: 100%;
}

/* High specificity to override Unity's default white input boxes */
.input-field .unity-text-field__input {
    background-color: transparent;
    background-image: none;
    border-color: transparent;
    border-width: 0;
    color: rgb(200, 200, 200);
    font-size: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.input-field .unity-text-field__input:focus {
    color: rgb(255, 255, 255);
}

/* --- ACTION BUTTONS --- */
.action-btn {
    width: 280px;
    height: 70px;
    margin-top: 35px; /* Positions the button directly into the button slot cutout */
    background-color: transparent;
    border-width: 0;
    transition-duration: 0.1s;
    -unity-background-scale-mode: scale-to-fit;
}

.action-btn:hover {
    scale: 1.05;
}

.action-btn:active {
    scale: 0.95;
}

/* --- ROOM BROWSER --- */
.browser-section {
    width: 90%;
    min-height: 90px;
    margin: 10px;
    align-items: center;
}

.secondary-btn {
    width: 240px;
    height: 54px;
    margin-bottom: 12px;
    background-color: rgb(42, 45, 50);
    border-color: rgb(225, 150, 50);
    border-width: 2px;
    color: rgb(225, 150, 50);
    font-size: 18px;
    -unity-font-style: bold;
}

.secondary-btn:hover {
    background-color: rgb(58, 60, 66);
    scale: 1.03;
}

.room-browser-panel {
    width: 100%;
    min-height: 300px;
    max-height: 430px;
    padding: 18px;
    background-color: rgb(25, 27, 31);
    border-color: rgb(105, 105, 105);
    border-width: 2px;
}

.room-browser-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.room-browser-title {
    color: rgb(225, 150, 50);
    font-size: 22px;
    -unity-font-style: bold;
}

.refresh-btn {
    width: 130px;
    height: 42px;
    background-color: rgb(50, 55, 62);
    border-color: rgb(150, 150, 150);
    border-width: 1px;
    color: rgb(225, 225, 225);
    font-size: 14px;
    -unity-font-style: bold;
}

.room-list {
    flex-grow: 1;
    min-height: 170px;
}

.room-row {
    flex-direction: row;
    align-items: center;
    min-height: 62px;
    margin-bottom: 8px;
    padding-left: 14px;
    padding-right: 12px;
    background-color: rgb(34, 37, 42);
    border-color: rgb(70, 74, 82);
    border-width: 1px;
}

.room-row-main {
    flex-grow: 1;
}

.room-name-text {
    color: rgb(240, 240, 240);
    font-size: 19px;
    -unity-font-style: bold;
}

.room-meta-text {
    color: rgb(170, 170, 170);
    font-size: 13px;
    margin-top: 3px;
}

.room-player-count {
    width: 70px;
    color: rgb(225, 150, 50);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.room-join-btn {
    width: 100px;
    height: 42px;
    margin-left: 8px;
    background-color: rgb(225, 150, 50);
    border-width: 0;
    color: rgb(20, 22, 25);
    font-size: 15px;
    -unity-font-style: bold;
}

.room-join-btn:hover {
    background-color: rgb(245, 172, 70);
    scale: 1.03;
}

.room-empty-text {
    color: rgb(170, 170, 170);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* --- GLOBAL STATUS --- */
.status-text {
    font-size: 16px;
    color: rgb(200, 50, 50);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

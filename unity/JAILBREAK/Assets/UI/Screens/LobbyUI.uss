.screen-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 22, 25);
    flex-direction: column;
}

.top-bar {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    padding-top: 20px;
    margin-bottom: 20px;
}

.top-bar-spacer {
    flex: 1;
}

.header-container {
    flex: 1;
    align-items: center;
    justify-content: flex-start;
}

.profile-container {
    flex: 1;
    align-items: flex-end;
    padding-right: 40px;
}

.logo-icon {
    width: 400px;
    height: 150px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
}

.profile-panel {
    width: 350px;
    height: 130px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: flex-start;
    -unity-background-scale-mode: scale-to-fit;
}

.profile-text {
    font-size: 18px;
    color: rgb(225, 150, 50);
    margin-top: 55px;
    -unity-font-style: bold;
}

.content-area {
    flex-grow: 1;
    width: 100%;
}

.content-area .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    min-height: 100%;
    padding-bottom: 40px;
}

.main-panel {
    width: 500px;
    height: 350px;
    margin: 20px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: flex-start;
    -unity-background-scale-mode: scale-to-fit;
}

.input-container {
    width: 380px;
    height: 50px;
    margin-top: 185px;
    align-items: center;
    justify-content: center;
}

.input-field {
    width: 100%;
    height: 100%;
}

.input-field .unity-text-field__input {
    background-color: transparent;
    background-image: none;
    border-color: transparent;
    border-width: 0;
    color: rgb(200, 200, 200);
    font-size: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.input-field .unity-text-field__input:focus {
    color: rgb(255, 255, 255);
}

.action-btn {
    width: 280px;
    height: 70px;
    margin-top: 35px;
    background-color: transparent;
    border-width: 0;
    transition-duration: 0.1s;
    -unity-background-scale-mode: scale-to-fit;
}

.action-btn:hover {
    scale: 1.05;
}

.action-btn:active {
    scale: 0.95;
}

.browser-section {
    width: 90%;
    min-height: 90px;
    margin: 10px;
    align-items: center;
}

.secondary-btn {
    width: 240px;
    height: 54px;
    margin-bottom: 12px;
    background-color: rgb(42, 45, 50);
    border-color: rgb(225, 150, 50);
    border-width: 2px;
    color: rgb(225, 150, 50);
    font-size: 18px;
    -unity-font-style: bold;
}

.secondary-btn:hover {
    background-color: rgb(58, 60, 66);
    scale: 1.03;
}

.room-browser-section {
    width: 100%;
    align-items: center;
}

.room-browser-frame {
    width: 100%;
    min-height: 320px;
    max-height: 460px;
    padding-top: 78px;
    padding-right: 28px;
    padding-bottom: 26px;
    padding-left: 28px;
    background-color: rgba(20, 22, 25, 0.55);
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/Sprites/lobby-screen-list-rooms-sprites.png?fileID=1780312201&guid=0dbf7cc16127c465e8fdb893519b8d89&type=3#lobby-screen-list-rooms-sprites_0");
}

.room-browser-content {
    flex-grow: 1;
}

.refresh-btn {
    position: absolute;
    top: 22px;
    right: 26px;
    width: 130px;
    height: 38px;
    background-color: rgba(50, 55, 62, 0.85);
    border-color: rgb(180, 120, 50);
    border-width: 1px;
    color: rgb(245, 215, 170);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.refresh-btn:hover {
    scale: 1.03;
}

.room-list {
    flex-grow: 1;
    min-height: 200px;
}

.room-row {
    flex-direction: row;
    align-items: center;
    min-height: 70px;
    margin-bottom: 10px;
    padding-left: 22px;
    padding-right: 16px;
    background-color: rgba(45, 48, 54, 0.8);
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/Sprites/room-screen-spreadsheet.png?fileID=151541509&guid=19920e34ac2a1471f9a687ec84c80c61&type=3#room-screen-spreadsheet_0");
}

.room-row-main {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.room-name-text {
    color: rgb(245, 230, 210);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.room-meta-text {
    color: rgb(0, 0, 0);
    font-size: 12px;
    margin-top: 2px;
}

.room-player-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-width: 86px;
    padding-left: 10px;
    padding-right: 12px;
    margin-right: 12px;
    background-color: rgba(20, 22, 25, 0.75);
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    background-image: url("project://database/Assets/UI/Sprites/lobby-screen-list-rooms-sprites.png?fileID=-1670298919&guid=0dbf7cc16127c465e8fdb893519b8d89&type=3#lobby-screen-list-rooms-sprites_2");
}

.room-player-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0);
}

.room-player-count {
    color: rgb(240, 240, 240);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.room-join-btn {
    width: 96px;
    height: 40px;
    background-color: rgb(225, 150, 50);
    border-width: 0;
    color: rgb(20, 22, 25);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-image: url("project://database/Assets/UI/Sprites/lobby-screen-list-rooms-sprites.png?fileID=-780673250&guid=0dbf7cc16127c465e8fdb893519b8d89&type=3#lobby-screen-list-rooms-sprites_3");
}

.room-join-btn:hover {
    scale: 1.03;
}

.room-join-btn:disabled {
    opacity: 0.4;
}

.room-empty-text {
    color: rgb(170, 170, 170);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 14px;
}

.status-text {
    font-size: 16px;
    color: rgb(200, 50, 50);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

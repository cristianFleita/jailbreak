<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="TutorialRoot" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; padding-top: 14px; padding-right: 14px; padding-bottom: 14px; padding-left: 14px; justify-content: space-between;">
        <ui:VisualElement name="TopBar" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: flex-start;">
            <ui:VisualElement name="RoleCard" picking-mode="Ignore" style="width: 380px; background-color: rgba(10, 14, 17, 0.78); padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; border-left-width: 4px; border-left-color: rgb(255, 102, 102); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label name="HeaderRoleLabel" text="ROLE: SECURITY GUARD" style="-unity-font-style: bold; font-size: 15px; color: rgb(255, 255, 255);"/>
                <ui:Label name="ObjectiveTitleLabel" text="Main Objective:" style="-unity-font-style: bold; font-size: 12px; color: rgb(255, 255, 255); margin-top: 6px;"/>
                <ui:Label name="ObjectiveBodyLabel" text="Stop the escapees before they reach the exit." style="font-size: 11px; color: rgb(236, 207, 207); white-space: normal; margin-top: 2px;"/>
                <ui:Label name="RulesTitleLabel" text="Rules of Engagement:" style="-unity-font-style: bold; font-size: 12px; color: rgb(255, 255, 255); margin-top: 8px;"/>
                <ui:Label text="- Identify: There are 20 prisoners; only 1 to 3 are trying to escape." style="font-size: 11px; color: rgb(236, 207, 207); white-space: normal; margin-top: 3px;"/>
                <ui:Label text="- Capture: Stand close and Hold [Left Click] to detain a suspect." style="font-size: 11px; color: rgb(236, 207, 207); white-space: normal; margin-top: 3px;"/>
                <ui:Label text="- Caution: 3 wrongful arrests will trigger a RIOT and you will lose." style="font-size: 11px; color: rgb(236, 207, 207); white-space: normal; margin-top: 3px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ErrorsPanel" picking-mode="Ignore" style="flex-direction: row; align-items: center; background-color: rgba(10, 14, 17, 0.78); padding-top: 10px; padding-right: 14px; padding-bottom: 10px; padding-left: 14px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label text="MISTAKES" style="-unity-font-style: bold; font-size: 10px; color: rgb(255, 184, 184); margin-right: 8px;"/>
                <ui:Label name="ErrorsLabel" text="0/3" style="-unity-font-style: bold; font-size: 16px; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>
            <ui:VisualElement name="TimerCard" picking-mode="Ignore" style="background-color: rgba(10, 14, 17, 0.78); padding-top: 10px; padding-right: 16px; padding-bottom: 10px; padding-left: 16px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label name="TimerLabel" text="GAME STARTS IN 01:30" style="-unity-font-style: bold; font-size: 16px; color: rgb(255, 255, 255); -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="CenterLayer" picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: center;">
            <ui:VisualElement name="FocusPanel" picking-mode="Ignore" style="width: 110px; align-items: center;">
                <ui:Label text="+" style="-unity-font-style: bold; font-size: 22px; color: rgb(255, 255, 255); -unity-text-align: middle-center;"/>
                <ui:VisualElement name="FocusTrack" picking-mode="Ignore" style="width: 106px; height: 7px; background-color: rgba(0, 0, 0, 0.62); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px;">
                    <ui:VisualElement name="FocusFill" picking-mode="Ignore" style="width: 0%; height: 100%; background-color: rgb(255, 96, 96);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Toast" picking-mode="Ignore" style="display: none; max-width: 560px; background-color: rgba(10, 14, 17, 0.86); padding-top: 8px; padding-right: 14px; padding-bottom: 8px; padding-left: 14px; margin-top: 34px; border-left-width: 3px; border-left-color: rgb(255, 198, 90); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label name="ToastLabel" text="" style="-unity-font-style: bold; font-size: 12px; color: rgb(255, 255, 255); white-space: normal; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="BottomBar" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: flex-end;">
            <ui:VisualElement name="ControlsPanel" picking-mode="Ignore" style="width: 310px; background-color: rgba(10, 14, 17, 0.72); padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label text="CONTROLS" style="-unity-font-style: bold; font-size: 11px; color: rgb(255, 255, 255); margin-bottom: 5px;"/>
                <ui:Label text="WASD + Mouse  Move and look" style="font-size: 10px; color: rgb(224, 214, 214);"/>
                <ui:Label text="Shift  Sprint to reposition" style="font-size: 10px; color: rgb(224, 214, 214);"/>
                <ui:Label text="E  Inspect safe practice props" style="font-size: 10px; color: rgb(224, 214, 214);"/>
                <ui:Label text="Left Click Hold  Focus capture" style="font-size: 10px; color: rgb(224, 214, 214);"/>
                <ui:Label name="CueLabel" text="Cue: watch routine first" style="-unity-font-style: bold; font-size: 10px; color: rgb(255, 216, 128); margin-top: 6px; white-space: normal;"/>
            </ui:VisualElement>

            <ui:VisualElement name="MissionPanel" picking-mode="Ignore" style="width: 430px; max-height: 500px; background-color: rgba(10, 14, 17, 0.78); padding-top: 10px; padding-right: 12px; padding-bottom: 10px; padding-left: 12px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgba(255, 255, 255, 0.14); border-right-color: rgba(255, 255, 255, 0.14); border-bottom-color: rgba(255, 255, 255, 0.14); border-left-color: rgba(255, 255, 255, 0.14); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:VisualElement name="MissionHeader" picking-mode="Ignore" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                    <ui:Label name="MissionTitle" text="Guard Missions" style="-unity-font-style: bold; font-size: 13px; color: rgb(255, 255, 255);"/>
                    <ui:Label name="CollapseHint" text="" style="display: none;"/>
                </ui:VisualElement>
                <ui:VisualElement name="MissionList" picking-mode="Ignore" style="flex-direction: column;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

VITE_BACKEND_URL=http://localhost:3001

# WebRTC voice. STUN-only is okay for local tests, but production should add TURN.
# Comma-separated URLs are supported.
VITE_VOICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Recommended for Vercel/Render production playtests. Use a TURN provider such as
# Metered, Twilio/NTS, Xirsys, Cloudflare Calls TURN, or your own coturn server.
VITE_VOICE_TURN_URLS=
VITE_VOICE_TURN_USERNAME=
VITE_VOICE_TURN_CREDENTIAL=

# Optional advanced override. If set, this JSON array replaces all variables above.
# VITE_VOICE_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:turn.example.com:5349","username":"user","credential":"pass"}]
